# Server only. Keep the real file outside Git and releases.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://atajan.org
# Only enable behind the supplied loopback Nginx proxy, which replaces X-Real-IP.
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=
# GitHub Pages builds use /portfolio/. VPS builds use /.
VITE_BASE_PATH=/
